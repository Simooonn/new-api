[Unit]
Description=Report that the new-api upgrade agent is installed

[Service]
Type=oneshot
# Run as the project owner so files under .upgrade/ stay writable for manual
# docker-upgrade.sh runs; docker is reached through sudo.
User=@RUN_USER@
Environment=PROJECT_DIR=@PROJECT_DIR@
Environment=CONTROL_DIR=@CONTROL_DIR@
ExecStart=@PROJECT_DIR@/deploy/upgrade-agent/new-api-upgrade-agent.sh heartbeat
ProtectHome=read-only
ReadWritePaths=@PROJECT_DIR@
