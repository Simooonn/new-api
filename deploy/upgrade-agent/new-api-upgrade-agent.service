[Unit]
Description=Run a new-api upgrade requested from the web console
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Run as the project owner so files under .upgrade/ stay writable for manual
# docker-upgrade.sh runs; docker is reached through sudo.
User=@RUN_USER@
Environment=PROJECT_DIR=@PROJECT_DIR@
Environment=CONTROL_DIR=@CONTROL_DIR@
Environment=IMAGE_REPO=ghcr.io/simooonn/new-api
ExecStart=@PROJECT_DIR@/deploy/upgrade-agent/new-api-upgrade-agent.sh run
TimeoutStartSec=900
# Let an upgrade finish even if the agent itself exits early.
KillMode=process
# Defense in depth: the agent only needs the project dir.
ProtectHome=read-only
ReadWritePaths=@PROJECT_DIR@
